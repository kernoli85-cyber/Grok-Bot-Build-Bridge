*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
dist/
build/
*.egg-info/
src/*.egg-info/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Test / coverage
.coverage
htmlcov/
.tox/

# App state DB (never commit)
**/*.sqlite
**/*.sqlite3
**/*.db
.state/
.bridge-state/
